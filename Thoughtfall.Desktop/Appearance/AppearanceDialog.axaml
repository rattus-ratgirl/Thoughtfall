<Window
    CanResize="False"
    SizeToContent="Height"
    Title="Appearance"
    Width="420"
    WindowStartupLocation="CenterOwner"
    x:Class="Thoughtfall.Desktop.Appearance.AppearanceDialog"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <StackPanel Margin="28" Spacing="18">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Appearance" />
        <StackPanel Spacing="6">
            <Label Content="_Editor Font Size" Padding="0" Target="{Binding #FontSizeBox}" />
            <ComboBox AutomationProperties.Name="Font size" HorizontalAlignment="Stretch" x:Name="FontSizeBox" />
        </StackPanel>
        <StackPanel Spacing="6">
            <Label Content="_Colour scheme" Padding="0" Target="{Binding #SchemePicker}" />
            <ComboBox AutomationProperties.Name="Colour scheme" HorizontalAlignment="Stretch" x:Name="SchemePicker" />
        </StackPanel>
        <StackPanel Spacing="6">
            <Label Content="_Palette" Padding="0" Target="{Binding #ModePicker}" />
            <ComboBox AutomationProperties.Name="Palette" HorizontalAlignment="Stretch" x:Name="ModePicker" />
            <TextBlock
                Classes="secondary"
                Text="Changes apply when saved. Match System follows your desktop's light or dark setting."
                TextWrapping="Wrap"
            />
        </StackPanel>
        <Border Classes="notice" IsVisible="False" x:Name="ErrorBanner">
            <TextBlock FontSize="12" TextWrapping="Wrap" x:Name="ErrorText" />
        </Border>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button Classes="quiet" Click="OnCancel" Content="Cancel" IsCancel="True" MinWidth="88" />
            <Button Classes="primary" Click="OnSave" Content="Save" MinWidth="88" />
        </StackPanel>
    </StackPanel>
</Window>
