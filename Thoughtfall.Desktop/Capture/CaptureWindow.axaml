<Window
    Height="430"
    Icon="/Assets/Thoughtfall.ico"
    MinHeight="360"
    MinWidth="480"
    Title="Thoughtfall"
    Width="620"
    WindowStartupLocation="CenterScreen"
    x:Class="Thoughtfall.Desktop.Capture.CaptureWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:capture="using:Thoughtfall.Desktop.Capture"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Grid Margin="28,22,28,16" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="New thought" />
                <TextBlock Classes="secondary" Text="One thought at a time." />
            </StackPanel>
            <Border
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Grid.Column="1"
                Padding="12,6"
                VerticalAlignment="Top"
            >
                <TextBlock Classes="secondary" x:Name="EntryDate" />
            </Border>
        </Grid>
        <Border
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1"
            Classes="capture-frame"
            ClipToBounds="True"
            CornerRadius="14"
            Grid.Row="1"
            x:Name="CaptureFrame"
        >
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" x:Name="EntryScroller">
                    <StackPanel x:Name="EntryStream">
                        <ItemsControl Margin="22,0" x:Name="History">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="capture:CaptureHistoryEntry" x:DataType="capture:CaptureHistoryEntry">
                                    <StackPanel Margin="0,18,0,0" Spacing="10">
                                        <TextBlock Classes="secondary" Text="{Binding Timestamp}" />
                                        <SelectableTextBlock
                                            FontSize="{DynamicResource EditorFontSize}"
                                            Foreground="{DynamicResource MutedTextBrush}"
                                            LineHeight="{DynamicResource EditorLineHeight}"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap"
                                        />
                                        <Grid ColumnDefinitions="*,3*,*" Margin="0,10,0,0">
                                            <Border Background="{DynamicResource StrokeBrush}" Grid.Column="1" Height="1" Opacity="0.5" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox
                            AcceptsReturn="True"
                            AutomationProperties.Name="Diary entry"
                            BorderThickness="0"
                            Classes="journal stream"
                            CornerRadius="0"
                            MaxLength="0"
                            MinHeight="{Binding #EntryScroller.Viewport.Height}"
                            PlaceholderText="What's on your mind?"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            TextChanged="OnTextChanged"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            x:Name="Editor"
                        />
                    </StackPanel>
                </ScrollViewer>
                <Border
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Margin="12"
                    Padding="12,8"
                    VerticalAlignment="Top"
                    x:Name="HistoryHint"
                >
                    <TextBlock Classes="secondary" Text="Continue scrolling to see previous entries" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
        <Border Classes="notice" Grid.Row="2" IsVisible="False" Margin="0,12,0,0" x:Name="StatusBanner">
            <ScrollViewer MaxHeight="100">
                <TextBlock FontSize="12" TextWrapping="Wrap" x:Name="StatusText" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,10,0,12" Orientation="Horizontal" Spacing="8">
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4" VerticalAlignment="Center">
                <TextBlock Classes="secondary" FontSize="11" Text="Ctrl + Enter" />
            </Border>
            <TextBlock Classes="secondary" Text="to save" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Click="OnCaptureShortcut" Content="Change Capture shortcut" IsVisible="False" x:Name="ShortcutButton" />
            <Button Classes="quiet" Click="OnAppearance" Content="Appearance" x:Name="AppearanceButton" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Grid.Row="4" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="-12,0,0,0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="quiet" Click="OnExport" Content="Export entries…" />
                    <Button Classes="quiet" Click="OnOpenFolder" Content="Data folder" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="quiet" Click="OnClose" Content="Quit" x:Name="CloseButton" />
                    <Button Classes="primary" Click="OnSave" Content="Save" IsEnabled="False" MinWidth="88" x:Name="SaveButton" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
