<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Thoughtfall.Desktop.App"
    x:ClassModifier="internal"
    RequestedThemeVariant="Default"
>
    <Application.Styles>
        <FluentTheme />
        <!-- App.Initialize inserts the named palettes here, before shared styles. -->
        <StyleInclude Source="/Themes/Thoughtfall.axaml" />
    </Application.Styles>
</Application>
