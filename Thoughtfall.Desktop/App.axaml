<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Thoughtfall.Desktop.App"
    x:ClassModifier="internal"
    RequestedThemeVariant="Default"
>
    <Application.Styles>
        <!-- Select the colour scheme here; load its Fluent theme before the shared styles. -->
        <StyleInclude Source="/Themes/Palettes/Thoughtfall.axaml" />
        <StyleInclude Source="/Themes/Thoughtfall.axaml" />
    </Application.Styles>
</Application>
