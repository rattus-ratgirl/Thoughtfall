<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Thoughtfall.Desktop.CaptureWindow"
    x:ClassModifier="internal"
    Title="Thoughtfall"
    Icon="/Assets/Thoughtfall.ico"
    Width="620"
    Height="430"
    MinWidth="480"
    MinHeight="360"
    WindowStartupLocation="CenterScreen"
>
    <Grid Margin="28,22,28,16" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="New thought" Classes="heading" />
                <TextBlock Text="One thought at a time." Classes="secondary" />
            </StackPanel>
            <Border
                Grid.Column="1"
                CornerRadius="14"
                Padding="12,6"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
            >
                <TextBlock x:Name="EntryDate" Classes="secondary" />
            </Border>
        </Grid>
        <TextBox
            x:Name="Editor"
            Grid.Row="1"
            Classes="journal"
            AutomationProperties.Name="Diary entry"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MaxLength="0"
            PlaceholderText="What's on your mind?"
            VerticalContentAlignment="Top"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="OnTextChanged"
        />
        <Border x:Name="StatusBanner" Grid.Row="2" Classes="notice" IsVisible="False" Margin="0,12,0,0">
            <ScrollViewer MaxHeight="100">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,12">
            <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="7,4">
                <TextBlock Text="Ctrl + Enter" Classes="secondary" FontSize="11" />
            </Border>
            <TextBlock Text="to save" Classes="secondary" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                    <Button Content="Export entries…" Classes="quiet" Click="OnExport" />
                    <Button Content="Data folder" Classes="quiet" Click="OnOpenFolder" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Quit" Classes="quiet" Click="OnQuit" />
                    <Button x:Name="SaveButton" Content="Save" Classes="primary" MinWidth="88" IsEnabled="False" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
