<local:PaletteResources
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Thoughtfall.Desktop"
>
    <local:PaletteResources.FluentColours>
        <ColorPaletteResources
            Accent="#ff9b503a"
            AltHigh="White"
            AltLow="White"
            AltMedium="White"
            AltMediumHigh="White"
            AltMediumLow="White"
            BaseHigh="#ff40332e"
            BaseLow="#fff0e5d7"
            BaseMedium="#ffae9b82"
            BaseMediumHigh="#ff826a49"
            BaseMediumLow="#ff988365"
            ChromeAltLow="#ff826a49"
            ChromeBlackHigh="Black"
            ChromeBlackLow="#fff0e5d7"
            ChromeBlackMedium="#ff826a49"
            ChromeBlackMediumLow="#ffae9b82"
            ChromeDisabledHigh="#fff0e5d7"
            ChromeDisabledLow="#ffae9b82"
            ChromeGray="#ff988365"
            ChromeHigh="#fff0e5d7"
            ChromeLow="#fffff4e4"
            ChromeMedium="#fffcf1e1"
            ChromeMediumLow="#fffff4e4"
            ChromeWhite="White"
            ListLow="#fffcf1e1"
            ListMedium="#fff0e5d7"
            RegionColor="#fff8f5ef"
        />
    </local:PaletteResources.FluentColours>
    <SolidColorBrush x:Key="PageBrush" Color="#F8F5EF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFCF6" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0E5D7" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#DED5C9" />
    <SolidColorBrush x:Key="TextBrush" Color="#40332E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#76695F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#9B503A" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#9B503A" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#8B4532" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#783B2B" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#F0E5D7" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#FFF4E4" />
</local:PaletteResources>
