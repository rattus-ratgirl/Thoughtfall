<local:PaletteResources
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Thoughtfall.Desktop"
>
    <!-- Catppuccin palette v1.8.0, MIT. See packaging/licenses/Catppuccin-MIT.txt. -->
    <local:PaletteResources.FluentColours>
        <ColorPaletteResources
            Accent="#c6a0f6"
            RegionColor="#24273a"
            AltHigh="#1e2030"
            AltMediumHigh="#CC1e2030"
            AltMedium="#991e2030"
            AltMediumLow="#661e2030"
            AltLow="#331e2030"
            BaseHigh="#cad3f5"
            BaseMediumHigh="#b8c0e0"
            BaseMedium="#a5adcb"
            BaseMediumLow="#8087a2"
            BaseLow="#494d64"
            ChromeHigh="#6e738d"
            ChromeMedium="#494d64"
            ChromeMediumLow="#363a4f"
            ChromeLow="#1e2030"
            ChromeAltLow="#1e2030"
            ChromeWhite="#24273a"
            ChromeBlackHigh="#181926"
            ChromeBlackMedium="#CC181926"
            ChromeBlackMediumLow="#66181926"
            ChromeBlackLow="#33181926"
            ChromeDisabledHigh="#363a4f"
            ChromeDisabledLow="#6e738d"
            ChromeGray="#8087a2"
            ListLow="#363a4f"
            ListMedium="#494d64"
            ErrorText="#ed8796"
        />
    </local:PaletteResources.FluentColours>
    <!-- Hover and pressed fills mix Mauve towards Text by 10% and 20%. -->
    <SolidColorBrush x:Key="PageBrush" Color="#24273a" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1e2030" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#363a4f" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#494d64" />
    <SolidColorBrush x:Key="TextBrush" Color="#cad3f5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#b8c0e0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#c6a0f6" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#c6a0f6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#c6a5f6" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#c7aaf6" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#24273a" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#40939ab7" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#363a4f" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#c6a5f6" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#c7aaf6" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#24273a" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#24273a" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#24273a" />
    <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="#24273a" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#c6a0f6" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#c6a5f6" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#c7aaf6" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#24273a" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#24273a" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#24273a" />
</local:PaletteResources>
