{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "Format changed files with CSharpier",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["csharpier", "format", "${staged}"],
      "include": ["**/*.cs", "**/*.csproj", "**/*.props", "**/*.targets", "**/*.slnx", "**/*.xml", "**/*.config", "**/*.xaml", "**/*.axaml"]
    }
  ]
}
